# ============================================================
# TEMPLATE KONFIGURASI — Dashboard Realtime (Sucofindo x BULOG)
#
# Cara setup di device baru:
#   1. Salin file ini menjadi .env  (copy .env.example .env)
#   2. Isi kredensial database di bagian DB_* di bawah
#   3. Jalankan: composer install
#   4. Jalankan: php artisan key:generate
#   5. Import database (pkgbsuco_bulog2025.sql) bila DB masih kosong,
#      lalu jalankan: php artisan migrate
#   6. WAJIB untuk cetak PDF BAST: jalankan queue worker
#      php artisan queue:work
# ============================================================

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# API key Gemini (opsional) — isi dengan key milik Anda, JANGAN commit nilainya
GEMINI_API_KEY=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database MySQL — sesuaikan dengan device ini
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=pkgbsuco_bulog2025
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Antrian memakai tabel database (jobs) — worker harus berjalan
# agar cetak PDF BAST berfungsi:  php artisan queue:work
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
